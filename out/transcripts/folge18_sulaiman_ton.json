{
 "segments": [
  {
   "start": 0.0,
   "end": 8.92,
   "text": "Noah, Ilyas, stellt euch vor, ihr könntet verstehen, was die Vögel singen."
  },
  {
   "start": 10.0,
   "end": 11.58,
   "text": "Was würden sie wohl sagen?"
  },
  {
   "start": 12.34,
   "end": 15.88,
   "text": "Vielleicht, wo gibt es leckere Körner?"
  },
  {
   "start": 17.14,
   "end": 18.18,
   "text": "Vielleicht."
  },
  {
   "start": 19.38,
   "end": 20.62,
   "text": "Kuschelt euch ein."
  },
  {
   "start": 21.5,
   "end": 25.26,
   "text": "Heute erzähle ich euch von Prophet Sulaiman."
  },
  {
   "start": 25.88,
   "end": 27.16,
   "text": "Friede sei mit ihm."
  },
  {
   "start": 27.16,
   "end": 30.48,
   "text": "Dem Sohn von Dawud."
  },
  {
   "start": 30.92,
   "end": 33.68,
   "text": "Allah lehrte ihn die Sprache der Vöbel."
  },
  {
   "start": 35.28,
   "end": 38.62,
   "text": "Und Allah machte ihm sogar den Winddienst bar,"
  },
  {
   "start": 39.22,
   "end": 43.36,
   "text": "der auf seinen Befehl zu dem gesegneten Land wehte."
  },
  {
   "start": 44.56,
   "end": 48.46,
   "text": "Einmal zog Sulaiman mit seinem großen Heer los."
  },
  {
   "start": 49.48,
   "end": 54.66,
   "text": "Gin, Menschen und Vögel, alle in guter Ordnung."
  },
  {
   "start": 55.66,
   "end": 59.46,
   "text": "Da kamen sie in ein Tal voller Ameisen."
  },
  {
   "start": 60.46,
   "end": 63.0,
   "text": "Und eine kleine Ameise rief."
  },
  {
   "start": 64.24,
   "end": 67.94,
   "text": "Ihr Ameisen, geht in eure Wohnungen,"
  },
  {
   "start": 68.8,
   "end": 73.78,
   "text": "damit Sulaiman und sein Heer euch nicht zertreten, ohne es zu merken."
  },
  {
   "start": 74.26,
   "end": 76.48,
   "text": "Die Ameise hat gesprochen?"
  },
  {
   "start": 77.54,
   "end": 80.1,
   "text": "Und Sulaiman hat es gehört?"
  },
  {
   "start": 80.88,
   "end": 81.58,
   "text": "Ja."
  },
  {
   "start": 82.22,
   "end": 84.58,
   "text": "Und Sulaiman lächelte darüber."
  },
  {
   "start": 85.8,
   "end": 87.46,
   "text": "Und er betete."
  },
  {
   "start": 88.36,
   "end": 93.24,
   "text": "Mein Herr, hilf mir dankbar zu sein für deine Gaben,"
  },
  {
   "start": 93.42,
   "end": 96.46,
   "text": "die du mir und meinen Eltern geschenkt hast."
  },
  {
   "start": 97.28,
   "end": 100.44,
   "text": "Und Gutes zu tun, das dir gefällt."
  },
  {
   "start": 101.4,
   "end": 103.92,
   "text": "Und lass mich durch deine Barmherzigkeit"
  },
  {
   "start": 103.92,
   "end": 106.98,
   "text": "zu deinen rechtschaffenen Dienern gehören."
  },
  {
   "start": 107.46,
   "end": 110.82,
   "text": "Er hat aufgepasst, dass er die Ameisen nicht zertritt,"
  },
  {
   "start": 110.82,
   "end": 111.34,
   "text": "oder?"
  },
  {
   "start": 112.08,
   "end": 113.98,
   "text": "Hör gut zu, mein Schatz."
  },
  {
   "start": 114.98,
   "end": 120.26,
   "text": "Die Ameise warnte die anderen, weil Sulaiman und sein Heer"
  },
  {
   "start": 120.26,
   "end": 124.14,
   "text": "sie zertreten könnten, ohne es zu merken."
  },
  {
   "start": 125.12,
   "end": 129.42,
   "text": "Und auch die kleinsten Tiere sind Allas Geschöpfe."
  },
  {
   "start": 130.4,
   "end": 134.38,
   "text": "Eines Tages schaute Sulaiman nach den Vögeln und fragte,"
  },
  {
   "start": 135.4,
   "end": 137.2,
   "text": "wo ist denn der Wiederhopf?"
  },
  {
   "start": 137.76,
   "end": 139.16,
   "text": "Ich sehe ihn nicht."
  },
  {
   "start": 140.12,
   "end": 145.38,
   "text": "Ich werde ihn streng bestrafen oder ihm sogar das Leben nehmen,"
  },
  {
   "start": 146.16,
   "end": 149.04,
   "text": "außer er bringt mir einen klaren Beweis."
  },
  {
   "start": 150.52,
   "end": 154.22,
   "text": "Kurz darauf kam der Wiederhopf angeflogen und sagte,"
  },
  {
   "start": 155.42,
   "end": 159.68,
   "text": "ich habe etwas in Erfahrung gebracht, das du noch nicht weißt."
  },
  {
   "start": 160.84,
   "end": 164.36,
   "text": "Ich komme aus Saba mit einer sicheren Nachricht."
  },
  {
   "start": 164.98,
   "end": 166.3,
   "text": "Was hat er gesehen?"
  },
  {
   "start": 166.96,
   "end": 168.22,
   "text": "Er erzählte."
  },
  {
   "start": 168.9,
   "end": 174.54,
   "text": "In Saba regiert eine Königin, ihr wurde von allem gegeben"
  },
  {
   "start": 175.06,
   "end": 178.08,
   "text": "und sie hat einen gewaltigen Thron."
  },
  {
   "start": 179.56,
   "end": 184.06,
   "text": "Aber sie und ihr Volk werfen sich vor der Sonne nieder,"
  },
  {
   "start": 184.4,
   "end": 185.32,
   "text": "statt vor Allah."
  },
  {
   "start": 186.76,
   "end": 191.02,
   "text": "Der Satan hat ihnen ihre Taten schön erscheinen lassen"
  },
  {
   "start": 191.54,
   "end": 194.28,
   "text": "und sie vom rechten Weg abgehalten."
  },
  {
   "start": 195.6,
   "end": 200.6,
   "text": "Sulaiman sagte, wir werden sehen, ob du die Wahrheit sagst."
  },
  {
   "start": 201.54,
   "end": 204.5,
   "text": "Er hat die Nachricht also erst geprüft."
  },
  {
   "start": 205.62,
   "end": 209.9,
   "text": "Sulaiman schrieb einen Brief und sagte zum Wiederhopf,"
  },
  {
   "start": 210.64,
   "end": 215.34,
   "text": "geh mit diesem Brief zu ihnen und wirf ihn zu ihnen hinab,"
  },
  {
   "start": 216.12,
   "end": 221.06,
   "text": "dann zieh dich zurück und sieh, was sie antworten."
  },
  {
   "start": 221.66,
   "end": 224.06,
   "text": "Die Königin sagte zu ihren Leuten,"
  },
  {
   "start": 225.42,
   "end": 228.4,
   "text": "mir wurde ein edler Brief zugeworfen."
  },
  {
   "start": 229.44,
   "end": 231.2,
   "text": "Er ist von Sulaiman."
  },
  {
   "start": 232.3,
   "end": 237.58,
   "text": "Im Namen Allahs, des Allahbarmas, des Barmherzigen."
  },
  {
   "start": 238.84,
   "end": 243.52,
   "text": "Seid nicht überheblich mir gegenüber und kommt zu mir,"
  },
  {
   "start": 243.66,
   "end": 246.28,
   "text": "indem ihr euch Allah ergebt."
  },
  {
   "start": 246.82,
   "end": 249.34,
   "text": "Ein Vogel als Briefträger?"
  },
  {
   "start": 249.34,
   "end": 254.12,
   "text": "Ja, der schnellste Briefträger der Welt."
  },
  {
   "start": 255.82,
   "end": 258.58,
   "text": "Die Königin beriet sich mit ihren Leuten"
  },
  {
   "start": 259.26,
   "end": 262.12,
   "text": "und schickte Sulaiman ein Geschenk."
  },
  {
   "start": 263.0,
   "end": 264.48,
   "text": "Aber Sulaiman sagte,"
  },
  {
   "start": 265.4,
   "end": 268.02,
   "text": "wollt ihr mich mit Reichtum unterstützen?"
  },
  {
   "start": 269.06,
   "end": 271.24,
   "text": "Was Allah mir gegeben hat,"
  },
  {
   "start": 271.9,
   "end": 276.1,
   "text": "ist besser als das, was er euch gegeben hat."
  },
  {
   "start": 277.16,
   "end": 280.58,
   "text": "Vielmehr freut ihr euch über euer Geschenk."
  },
  {
   "start": 281.04,
   "end": 283.62,
   "text": "Und er schickte das Geschenk zurück."
  },
  {
   "start": 284.74,
   "end": 286.2,
   "text": "Er wollte keine Schätze,"
  },
  {
   "start": 287.12,
   "end": 289.28,
   "text": "sondern, dass sie sich Allah ergeben."
  },
  {
   "start": 290.46,
   "end": 294.66,
   "text": "Bevor die Königin ankam, fragte Sulaiman,"
  },
  {
   "start": 295.78,
   "end": 298.0,
   "text": "wer bringt mir ihren Thron?"
  },
  {
   "start": 299.62,
   "end": 301.52,
   "text": "Ein starker Djinn sagte,"
  },
  {
   "start": 302.5,
   "end": 304.18,
   "text": "ich bringe ihn dir,"
  },
  {
   "start": 304.18,
   "end": 307.68,
   "text": "bevor du von deinem Platz aufstehst."
  },
  {
   "start": 308.86,
   "end": 312.64,
   "text": "Aber einer, der Wissen aus dem Buch hatte, sagte,"
  },
  {
   "start": 313.76,
   "end": 315.42,
   "text": "ich bringe ihn dir,"
  },
  {
   "start": 316.06,
   "end": 319.1,
   "text": "bevor dein Blick zu dir zurückkehrt."
  },
  {
   "start": 320.2,
   "end": 323.98,
   "text": "Und schon stand der Thron vor Sulaiman."
  },
  {
   "start": 324.92,
   "end": 326.7,
   "text": "Und Sulaiman sagte sofort,"
  },
  {
   "start": 327.8,
   "end": 330.12,
   "text": "das ist von der Hult meines Herrn,"
  },
  {
   "start": 330.64,
   "end": 332.32,
   "text": "um mich zu prüfen,"
  },
  {
   "start": 332.32,
   "end": 336.42,
   "text": "ob ich dankbar oder undankbar bin."
  },
  {
   "start": 337.64,
   "end": 339.2,
   "text": "Wer dankbar ist,"
  },
  {
   "start": 339.62,
   "end": 342.62,
   "text": "der ist es zu seinem eigenen Nutzen."
  },
  {
   "start": 343.52,
   "end": 345.9,
   "text": "Und wer undankbar ist,"
  },
  {
   "start": 346.78,
   "end": 349.52,
   "text": "mein Herr ist auf niemanden angewiesen"
  },
  {
   "start": 350.24,
   "end": 352.3,
   "text": "und voller Güte."
  },
  {
   "start": 352.76,
   "end": 355.3,
   "text": "Sulaiman ließ ihren Thron verändern"
  },
  {
   "start": 355.3,
   "end": 357.98,
   "text": "und zu sehen, ob sie ihn erkennt."
  },
  {
   "start": 359.1,
   "end": 361.98,
   "text": "Als sie kam, wurde sie gefragt,"
  },
  {
   "start": 363.0,
   "end": 364.8,
   "text": "ist dein Thron so?"
  },
  {
   "start": 366.24,
   "end": 367.12,
   "text": "Sie sagte,"
  },
  {
   "start": 368.36,
   "end": 370.94,
   "text": "es ist, als wäre er es."
  },
  {
   "start": 372.1,
   "end": 373.44,
   "text": "Und Sulaiman sagte,"
  },
  {
   "start": 374.7,
   "end": 377.3,
   "text": "wir hatten schon vorher Wissen erhalten"
  },
  {
   "start": 377.3,
   "end": 380.18,
   "text": "und waren Allah ergeben."
  },
  {
   "start": 382.02,
   "end": 385.7,
   "text": "Bisher hatte sie anderes statt Allah angebetet."
  },
  {
   "start": 386.62,
   "end": 388.92,
   "text": "Dann kam sie in einen Palast."
  },
  {
   "start": 390.1,
   "end": 393.78,
   "text": "Der Boden war aus glattem, durchsichtigem Glas."
  },
  {
   "start": 394.96,
   "end": 397.44,
   "text": "Sie dachte, es wäre tiefes Wasser."
  },
  {
   "start": 399.0,
   "end": 400.12,
   "text": "Sulaiman sagte,"
  },
  {
   "start": 401.06,
   "end": 405.38,
   "text": "das ist ein Palast mit einem glatten Boden aus Glas."
  },
  {
   "start": 406.46,
   "end": 407.82,
   "text": "Da sagte sie,"
  },
  {
   "start": 408.64,
   "end": 409.26,
   "text": "mein Herr,"
  },
  {
   "start": 410.26,
   "end": 412.62,
   "text": "ich habe mir selbst Unrecht getan."
  },
  {
   "start": 413.62,
   "end": 415.68,
   "text": "Ich unterwerfe mich"
  },
  {
   "start": 415.68,
   "end": 418.82,
   "text": "gemeinsam mit Sulaiman Allah,"
  },
  {
   "start": 419.5,
   "end": 420.96,
   "text": "dem Herrn der Welten."
  },
  {
   "start": 421.46,
   "end": 423.74,
   "text": "Sie hat sich Allah ergeben,"
  },
  {
   "start": 424.4,
   "end": 425.5,
   "text": "Subhanallah."
  },
  {
   "start": 426.98,
   "end": 428.82,
   "text": "Ja, mein Schatz."
  },
  {
   "start": 429.58,
   "end": 432.42,
   "text": "Sulaiman war ein großer König"
  },
  {
   "start": 432.42,
   "end": 434.72,
   "text": "mit wunderbaren Gaben."
  },
  {
   "start": 435.12,
   "end": 437.56,
   "text": "Und für alles dankte er Allah."
  },
  {
   "start": 438.32,
   "end": 440.38,
   "text": "Mollen wir einen Satz"
  },
  {
   "start": 440.38,
   "end": 442.74,
   "text": "aus seinem Bittgebet zusammensagen?"
  },
  {
   "start": 444.64,
   "end": 445.58,
   "text": "Mein Herr,"
  },
  {
   "start": 446.38,
   "end": 448.4,
   "text": "hilf mir dankbar zu sein."
  },
  {
   "start": 448.94,
   "end": 449.88,
   "text": "Mein Herr,"
  },
  {
   "start": 450.44,
   "end": 452.32,
   "text": "hilf mir dankbar zu sein."
  },
  {
   "start": 453.34,
   "end": 454.0,
   "text": "Oh,"
  },
  {
   "start": 454.48,
   "end": 455.9,
   "text": "sie schlafen schon."
  },
  {
   "start": 457.72,
   "end": 458.32,
   "text": "Meine Lieben,"
  },
  {
   "start": 459.72,
   "end": 462.66,
   "text": "seid dankbar wie Sulaiman für alles,"
  },
  {
   "start": 463.12,
   "end": 465.62,
   "text": "was Allah euch schenkt."
  },
  {
   "start": 466.38,
   "end": 468.3,
   "text": "Passt auf die Kleinen auf,"
  },
  {
   "start": 468.54,
   "end": 470.36,
   "text": "sogar auf die Ameisen."
  },
  {
   "start": 471.64,
   "end": 474.54,
   "text": "Und glaubt nicht jede Nachricht sofort."
  },
  {
   "start": 475.42,
   "end": 476.48,
   "text": "Prüft sie,"
  },
  {
   "start": 476.7,
   "end": 478.5,
   "text": "bevor ihr sie weitersagt."
  },
  {
   "start": 479.46,
   "end": 481.48,
   "text": "Und nächstes Mal"
  },
  {
   "start": 481.48,
   "end": 484.7,
   "text": "erzähle ich euch von einem Propheten,"
  },
  {
   "start": 484.78,
   "end": 486.62,
   "text": "der genauso heißt,"
  },
  {
   "start": 487.08,
   "end": 488.94,
   "text": "wie einer von euch."
  },
  {
   "start": 490.36,
   "end": 492.16,
   "text": "Prophet Elias."
  },
  {
   "start": 493.54,
   "end": 495.08,
   "text": "Und du,"
  },
  {
   "start": 495.58,
   "end": 497.42,
   "text": "der du gerade zuschaust,"
  },
  {
   "start": 498.42,
   "end": 500.58,
   "text": "wenn dir die Geschichte gefallen hat,"
  },
  {
   "start": 501.36,
   "end": 502.94,
   "text": "dann frag deine Eltern,"
  },
  {
   "start": 503.4,
   "end": 505.94,
   "text": "ob sie unseren Kanal abonnieren."
  },
  {
   "start": 507.36,
   "end": 510.2,
   "text": "So verpasst du die nächste Geschichte nicht."
  },
  {
   "start": 512.0,
   "end": 513.76,
   "text": "Schlaft gut, meine Lieben."
  },
  {
   "start": 514.9,
   "end": 516.32,
   "text": "Allah beschütze euch."
  }
 ]
}